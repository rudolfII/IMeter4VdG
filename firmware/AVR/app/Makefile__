MCU = atmega328p
F_CPU = 16000000UL
PORT = /dev/ttyUSB0
BAUD = 115200

all: app.hex

app.elf: app.c
	avr-gcc -Os -DF_CPU=$(F_CPU) -mmcu=$(MCU) app.c -o app.elf

app.hex: app.elf
	avr-objcopy -O ihex -R .eeprom app.elf app.hex

# Run 'make flash' to upload via USB
flash: app.hex
	avrdude -c arduino -p $(MCU) -P $(PORT) -b $(BAUD) -U flash:w:.hex:i

clean:
	rm -f *.o *.elf *.hex
